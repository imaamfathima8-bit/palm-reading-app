# ------------------------------------------------------------------
# Copy this file to `.env` and fill in ONE provider's key.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# NEVER commit your real .env file. It is listed in .gitignore.
# ------------------------------------------------------------------

# Which LLM backend to use: gemini | groq | openai
MODEL_PROVIDER=gemini

# --- Google Gemini (free tier: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# --- Groq (free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# --- OpenAI or any OpenAI-compatible endpoint ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# Leave blank for api.openai.com; set to use a compatible server
# (e.g. a local Ollama / LM Studio endpoint: http://localhost:11434/v1)
OPENAI_BASE_URL=

# --- Generation settings ---
# Low temperature keeps the report close to the retrieved knowledge base
# (applies to Groq/OpenAI; Gemini 3.x uses Google's default).
LLM_TEMPERATURE=0.4
LLM_MAX_TOKENS=4096

# --- Privacy ---
# true  = save annotated images to ./assets for your report evidence
# false = keep everything in memory only (recommended for real users)
SAVE_OUTPUTS=false
